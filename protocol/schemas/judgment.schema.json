{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signoff-protocol:schema:judgment:1",
  "title": "Signoff Roast Lead Judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "iteration",
    "judge",
    "artifact_hashes",
    "decision",
    "criterion_decisions",
    "finding_dispositions",
    "conflict_resolutions",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string"
    },
    "iteration": {
      "type": "integer"
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "provider",
        "model",
        "context_id"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_hashes": {
      "type": "object",
      "required": [
        "contract",
        "evidence",
        "patch"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "patch": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "REWORK",
        "BLOCKED"
      ]
    },
    "criterion_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "acceptance_id",
          "verdict",
          "reason"
        ],
        "properties": {
          "acceptance_id": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "finding_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "disposition",
          "rationale",
          "evidence_ref"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "ACT_ON",
              "CONSIDER",
              "NOTED",
              "DISMISSED",
              "OUT_OF_SCOPE"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 5
          },
          "evidence_ref": {
            "type": "string"
          }
        }
      }
    },
    "conflict_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "acceptance_id",
          "basis",
          "evidence_ref",
          "conclusion"
        ],
        "properties": {
          "acceptance_id": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "experiment",
              "existing_evidence",
              "locked_spec",
              "user_decision"
            ]
          },
          "evidence_ref": {
            "type": "string"
          },
          "conclusion": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 8
    }
  }
}
