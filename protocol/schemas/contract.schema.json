{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:signoff-protocol:schema:contract:1",
  "title": "Signoff Iteration Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "iteration",
    "title",
    "builder",
    "requirements",
    "acceptance_criteria",
    "allowed_paths",
    "forbidden_paths",
    "exempt_paths",
    "budgets",
    "verification",
    "final"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "provider",
        "model",
        "context_id"
      ],
      "properties": {
        "participant_id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "exempt_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_files",
        "changed_lines"
      ],
      "properties": {
        "production_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "changed_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "timeout_seconds",
          "working_directory",
          "acceptance_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "working_directory": {
            "type": "string"
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "final": {
      "type": "boolean"
    }
  }
}
