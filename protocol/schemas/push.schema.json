{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:traction-protocol:schema:push:1",
  "title": "Traction Push Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifact_hashes",
    "advisors",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "artifact_hashes": {
      "type": "object",
      "required": [
        "goal",
        "charter",
        "spec"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "charter": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "spec": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "advisors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "independent_first_round",
          "verdict",
          "route",
          "falsifiable_criteria",
          "risk",
          "first_move",
          "cut"
        ],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "participant_id",
              "provider",
              "model",
              "context_id"
            ],
            "properties": {
              "participant_id": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "context_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "independent_first_round": {
            "const": true
          },
          "verdict": {
            "enum": [
              "PROCEED",
              "STOP",
              "PIVOT"
            ]
          },
          "route": {
            "type": "string",
            "minLength": 8
          },
          "falsifiable_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 8
            }
          },
          "risk": {
            "type": "string",
            "minLength": 5
          },
          "first_move": {
            "type": "string",
            "minLength": 4
          },
          "cut": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "rationale",
        "route_synthesis",
        "conflict_resolutions",
        "first_slice",
        "chair"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "PROCEED",
            "STOP",
            "PIVOT",
            "INSUFFICIENT_QUORUM"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        },
        "route_synthesis": {
          "type": "string",
          "minLength": 12
        },
        "first_slice": {
          "type": "string"
        },
        "chair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "participant_id",
            "provider",
            "model",
            "context_id"
          ],
          "properties": {
            "participant_id": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "context_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "conflict_resolutions": {
          "description": "Evidence-based resolutions for runtime-reported material conflicts such as verdict-split or advisor-unanimous-<verdict> when the chair overrides unanimous advisors. STOP may always be chosen honestly without an override.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "basis",
              "evidence",
              "conclusion"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "enum": [
                  "experiment",
                  "existing_evidence",
                  "locked_spec",
                  "user_decision"
                ]
              },
              "evidence": {
                "type": "string",
                "minLength": 5
              },
              "conclusion": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        }
      }
    }
  }
}
