{
  "name": "signoff-workspace",
  "private": true,
  "version": "0.1.0-alpha.1",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace @signoff/web run dev",
    "build:web": "npm --workspace @signoff/web run build && python3 scripts/copy_web_dist.py",
    "typecheck": "npm --workspace @signoff/web run typecheck",
    "test": "python3 scripts/test.py",
    "check": "python3 scripts/check_repo.py"
  },
  "engines": {
    "node": ">=22.12"
  }
}
